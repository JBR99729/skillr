[{"id":"ac9m9a04-p-001","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"practice","skill":"quadratic_values","question":"For y = x², find y when x = 3.","audio_prompt":"For y = x squared, find y when x = 3.","visual":{"type":"none","alt_text":""},"answers":[{"text":"9","is_correct":true},{"text":"6","is_correct":false},{"text":"3","is_correct":false},{"text":"12","is_correct":false}],"correct_index":0,"explanation":{"summary":"3² = 9.","hint":"Square 3."},"difficulty":1,"sequence_priority":1},{"id":"ac9m9a04-p-002","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"practice","skill":"quadratic_roots","question":"Solve x² = 16.","audio_prompt":"Solve x squared equals 16.","visual":{"type":"none","alt_text":""},"answers":[{"text":"x = ±4","is_correct":true},{"text":"x = 4 only","is_correct":false},{"text":"x = ±8","is_correct":false},{"text":"x = 8 only","is_correct":false}],"correct_index":0,"explanation":{"summary":"Both 4 and -4 square to 16.","hint":"Take both square roots."},"difficulty":1,"sequence_priority":1},{"id":"ac9m9a04-p-003","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"practice","skill":"quadratic_roots","question":"Solve x² - 9 = 0.","audio_prompt":"Solve x squared minus 9 equals zero.","visual":{"type":"none","alt_text":""},"answers":[{"text":"x = ±3","is_correct":true},{"text":"x = 9","is_correct":false},{"text":"x = -9","is_correct":false},{"text":"x = 3 only","is_correct":false}],"correct_index":0,"explanation":{"summary":"x² = 9, so x = ±3.","hint":"Isolate x² first."},"difficulty":1,"sequence_priority":1},{"id":"ac9m9a04-p-004","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"practice","skill":"quadratic_values","question":"For y = x² + 1, what is y when x = -2?","audio_prompt":"For y equals x squared plus 1, what is y when x equals negative 2?","visual":{"type":"none","alt_text":""},"answers":[{"text":"5","is_correct":true},{"text":"3","is_correct":false},{"text":"-3","is_correct":false},{"text":"-5","is_correct":false}],"correct_index":0,"explanation":{"summary":"(-2)² + 1 = 5.","hint":"Square -2 before adding 1."},"difficulty":1,"sequence_priority":1},{"id":"ac9m9a04-p-005","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"practice","skill":"quadratic_roots","question":"Solve x² + 5x + 6 = 0.","audio_prompt":"Solve x squared plus 5x plus 6 equals zero.","visual":{"type":"none","alt_text":""},"answers":[{"text":"x = -2 or -3","is_correct":true},{"text":"x = 2 or 3","is_correct":false},{"text":"x = -1 or -6","is_correct":false},{"text":"x = 1 or 6","is_correct":false}],"correct_index":0,"explanation":{"summary":"Factorise to (x+2)(x+3)=0.","hint":"Find factors of 6 that add to 5."},"difficulty":1,"sequence_priority":1},{"id":"ac9m9a04-p-006","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"practice","skill":"turning_point","question":"What is the vertex of y = (x - 2)² + 3?","audio_prompt":"What is the vertex of y equals open bracket x minus 2 close bracket squared plus 3?","visual":{"type":"none","alt_text":""},"answers":[{"text":"(2, 3)","is_correct":true},{"text":"(-2, 3)","is_correct":false},{"text":"(2, -3)","is_correct":false},{"text":"(-2, -3)","is_correct":false}],"correct_index":0,"explanation":{"summary":"In y=(x-h)²+k, the vertex is (h,k).","hint":"Read h and k from vertex form."},"difficulty":1,"sequence_priority":1},{"id":"ac9m9a04-p-007","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"practice","skill":"symmetry","question":"What is the axis of symmetry of y = (x + 4)² - 1?","audio_prompt":"What is the axis of symmetry of y equals open bracket x plus 4 close bracket squared minus 1?","visual":{"type":"none","alt_text":""},"answers":[{"text":"x = -4","is_correct":true},{"text":"x = 4","is_correct":false},{"text":"y = -1","is_correct":false},{"text":"x = -1","is_correct":false}],"correct_index":0,"explanation":{"summary":"The vertex has x-coordinate -4.","hint":"The symmetry line passes through the vertex."},"difficulty":1,"sequence_priority":1},{"id":"ac9m9a04-p-008","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"practice","skill":"quadratic_roots","question":"Solve x(x - 7) = 0.","audio_prompt":"Solve x open bracket x minus 7 close bracket equals zero.","visual":{"type":"none","alt_text":""},"answers":[{"text":"x = 0 or 7","is_correct":true},{"text":"x = 7 only","is_correct":false},{"text":"x = 0 or -7","is_correct":false},{"text":"x = -7 only","is_correct":false}],"correct_index":0,"explanation":{"summary":"Set each factor equal to zero.","hint":"Use the zero-product rule."},"difficulty":1,"sequence_priority":1},{"id":"ac9m9a04-t-009","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"test","skill":"quadratic_roots","question":"Solve x² - 5x + 6 = 0.","audio_prompt":"Solve x squared minus 5x plus 6 equals zero.","visual":{"type":"none","alt_text":""},"answers":[{"text":"x = 2 or 3","is_correct":true},{"text":"x = -2 or -3","is_correct":false},{"text":"x = 1 or 6","is_correct":false},{"text":"x = -1 or -6","is_correct":false}],"correct_index":0,"explanation":{"summary":"Factorise to (x-2)(x-3)=0.","hint":"Find factors of 6 that add to -5."},"difficulty":2,"sequence_priority":2},{"id":"ac9m9a04-t-010","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"test","skill":"quadratic_values","question":"For y = x² - 4x + 1, find y when x = 5.","audio_prompt":"For y equals x squared minus 4x plus 1, find y when x equals 5.","visual":{"type":"none","alt_text":""},"answers":[{"text":"6","is_correct":true},{"text":"4","is_correct":false},{"text":"10","is_correct":false},{"text":"-4","is_correct":false}],"correct_index":0,"explanation":{"summary":"25 - 20 + 1 = 6.","hint":"Substitute x=5 carefully."},"difficulty":2,"sequence_priority":2},{"id":"ac9m9a04-t-011","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"test","skill":"quadratic_roots","question":"Solve 2x² - 8 = 0.","audio_prompt":"Solve 2x squared minus 8 equals zero.","visual":{"type":"none","alt_text":""},"answers":[{"text":"x = ±2","is_correct":true},{"text":"x = ±4","is_correct":false},{"text":"x = 2 only","is_correct":false},{"text":"x = 4 only","is_correct":false}],"correct_index":0,"explanation":{"summary":"2x²=8 gives x²=4, so x=±2.","hint":"Divide by 2 before taking square roots."},"difficulty":2,"sequence_priority":2},{"id":"ac9m9a04-t-012","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"test","skill":"quadratic_features","question":"For y = -2(x - 1)² + 8, what is the maximum value of y?","audio_prompt":"For y equals negative 2 open bracket x minus 1 close bracket squared plus 8, what is the maximum value of y?","visual":{"type":"none","alt_text":""},"answers":[{"text":"8","is_correct":true},{"text":"1","is_correct":false},{"text":"-2","is_correct":false},{"text":"6","is_correct":false}],"correct_index":0,"explanation":{"summary":"The parabola opens downward and its vertex is (1,8).","hint":"The y-coordinate of the vertex is the maximum."},"difficulty":2,"sequence_priority":2},{"id":"ac9m9a04-t-013","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"test","skill":"quadratic_roots","question":"Solve x² + 2x - 15 = 0.","audio_prompt":"Solve x squared plus 2x minus 15 equals zero.","visual":{"type":"none","alt_text":""},"answers":[{"text":"x = 3 or -5","is_correct":true},{"text":"x = 5 or -3","is_correct":false},{"text":"x = 1 or -15","is_correct":false},{"text":"x = -1 or 15","is_correct":false}],"correct_index":0,"explanation":{"summary":"Factorise to (x+5)(x-3)=0.","hint":"Find factors of -15 that add to 2."},"difficulty":3,"sequence_priority":2},{"id":"ac9m9a04-t-014","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"test","skill":"quadratic_features","question":"For y = x² - 6x + 5, what is the x-coordinate of the vertex?","audio_prompt":"For y equals x squared minus 6x plus 5, what is the x-coordinate of the vertex?","visual":{"type":"none","alt_text":""},"answers":[{"text":"3","is_correct":true},{"text":"-3","is_correct":false},{"text":"5","is_correct":false},{"text":"6","is_correct":false}],"correct_index":0,"explanation":{"summary":"For ax²+bx+c, x=-b/(2a)=6/2=3.","hint":"Use x=-b/(2a)."},"difficulty":3,"sequence_priority":2},{"id":"ac9m9a04-t-015","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"test","skill":"quadratic_roots","question":"Solve 3x² - 12x = 0.","audio_prompt":"Solve 3x squared minus 12x equals zero.","visual":{"type":"none","alt_text":""},"answers":[{"text":"x = 0 or 4","is_correct":true},{"text":"x = 4 only","is_correct":false},{"text":"x = 0 or -4","is_correct":false},{"text":"x = 3 or 4","is_correct":false}],"correct_index":0,"explanation":{"summary":"Factorise 3x(x-4)=0.","hint":"Factor out 3x first."},"difficulty":3,"sequence_priority":2},{"id":"ac9m9a04-t-016","curriculum_code":"AC9M9A04","year_level":"Year 9","subject":"math","bank":"test","skill":"quadratic_features","question":"The roots of y = x² - 7x + 12 are 3 and 4. What is the axis of symmetry?","audio_prompt":"The roots of y equals x squared minus 7x plus 12 are 3 and 4. What is the axis of symmetry?","visual":{"type":"none","alt_text":""},"answers":[{"text":"x = 3.5","is_correct":true},{"text":"x = 7","is_correct":false},{"text":"x = 1","is_correct":false},{"text":"x = 12","is_correct":false}],"correct_index":0,"explanation":{"summary":"The axis lies halfway between the roots: (3+4)/2=3.5.","hint":"Average the two roots."},"difficulty":4,"sequence_priority":2}]